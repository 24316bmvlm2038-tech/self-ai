# ---------------------------------------------------------------------------
# Self-AI configuration. Copy this file to `.env` and fill in your API key.
# ---------------------------------------------------------------------------

# Required: your DeepSeek API key (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# Default model. deepseek-chat is fast and great at tool use;
# deepseek-reasoner "thinks" before answering (slower, better at hard problems).
DEEPSEEK_MODEL=deepseek-chat
# Models offered in the chat model picker (comma-separated).
# DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner
# DEEPSEEK_TEMPERATURE=

# Any OpenAI-compatible endpoint works, e.g. a local Ollama server:
#   DEEPSEEK_BASE_URL=http://localhost:11434/v1
#   DEEPSEEK_MODEL=<a model that supports tool calling>
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: better web search via Tavily (https://tavily.com). Without it, DuckDuckGo is used.
# TAVILY_API_KEY=

# Where conversations, tasks and the AI's workspace files are stored.
# SELFAI_DATA_DIR=data

# Web server. Keep 127.0.0.1 unless you need access from other devices;
# if you expose it, set a password and list the host names you will use.
# SELFAI_HOST=127.0.0.1
# SELFAI_PORT=8000
# SELFAI_PASSWORD=
# SELFAI_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Background tasks
# SELFAI_MAX_CONCURRENT_TASKS=2
# SELFAI_MAX_ACTIVE_TASKS=50
# SELFAI_TASK_MAX_STEPS=50
# SELFAI_CHAT_MAX_STEPS=25

# Internet tools
# SELFAI_ALLOW_PRIVATE_NETWORK=false
# SELFAI_MAX_DOWNLOAD_MB=50
# SELFAI_TOOL_TIMEOUT=120
