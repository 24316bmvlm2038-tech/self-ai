# ---------------------------------------------------------------------------
# Self-AI configuration. Copy this file to `.env` (start.sh does it for you).
# ---------------------------------------------------------------------------

# Which AI to use:
#   ollama   - free models that run on this device (phone or computer). Default.
#   deepseek - the DeepSeek API (paid, needs DEEPSEEK_API_KEY). Chosen automatically if a key is set.
# SELFAI_PROVIDER=ollama

# --- Free local models (Ollama) --------------------------------------------
# Default model. You can download and switch models in the app's Models panel.
# Good picks: qwen3.5:4b (8 GB RAM phones), qwen3.5:2b (6 GB), qwen3.5:0.8b (4 GB), qwen3.5:9b (computers)
# SELFAI_MODEL=qwen3.5:4b
# SELFAI_OLLAMA_URL=http://127.0.0.1:11434
# How much text the model can consider at once. Higher = remembers more, uses more RAM.
# SELFAI_CONTEXT_TOKENS=8192
# Let background tasks "think" step by step (smarter, slower).
# SELFAI_TASK_THINKING=true

# --- DeepSeek API ------------------------------------------------------------
# Get a key at https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner
# Any OpenAI-compatible API works too:
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Web search ----------------------------------------------------------------
# Optional: better web search via Tavily (https://tavily.com). Without it, DuckDuckGo is used.
# TAVILY_API_KEY=

# --- Server ----------------------------------------------------------------------
# Where conversations, tasks and the AI's files are stored.
# SELFAI_DATA_DIR=data
# Keep 127.0.0.1 unless you need access from other devices; if you expose it,
# set a password and list the host names you will use.
# SELFAI_HOST=127.0.0.1
# SELFAI_PORT=8000
# SELFAI_PASSWORD=
# SELFAI_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# --- Limits --------------------------------------------------------------------
# SELFAI_MAX_CONCURRENT_TASKS=1
# SELFAI_MAX_ACTIVE_TASKS=50
# SELFAI_TASK_MAX_STEPS=30
# SELFAI_CHAT_MAX_STEPS=15
# SELFAI_ALLOW_PRIVATE_NETWORK=false
# SELFAI_MAX_DOWNLOAD_MB=50
# SELFAI_TOOL_TIMEOUT=120
